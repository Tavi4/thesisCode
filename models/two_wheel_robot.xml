<mujoco model="two_wheel_robot">
    <compiler angle="degree"/>

    <option timestep="0.002"
            gravity="0 0 -9.81"/>

    <worldbody>
        <light pos="0 0 2"
               dir="0 0 -1"/>

        <!-- Ground -->
        <geom name="floor"
              type="plane"
              pos="0 0 0"
              size="2 2 0.1"
              friction="2.0 0.01 0.001"
              condim="3"
              rgba="0.85 0.85 0.85 1"/>

        <!-- Main robot body -->
        <!-- Isaac Sim MJCF importer supports at most 3 joints per body pair.
     The original robot body had 4 joints (X, Y, Z, yaw), so they are split
     across two nested bodies while preserving the same effective DOFs. -->
       <body name="robot_xy" pos="0 0 0.11">

       <joint name="robot_x"
              type="slide"
              axis="1 0 0"/>

       <joint name="robot_y"
              type="slide"
              axis="0 1 0"/>

       <!-- tiny physical representation for the intermediate body -->
       <geom name="robot_xy_dummy"
              type="sphere"
              size="0.001"
              mass="0.001"
              contype="0"
              conaffinity="0"
              rgba="0 0 0 0"/>

       <body name="robot">

              <joint name="robot_z"
                     type="slide"
                     axis="0 0 1"
                     damping="0.1"/>

              <joint name="robot_yaw"
                     type="hinge"
                     axis="0 0 1"/>

            <!-- Central cylindrical bar -->
            <geom name="chassis_geom"
                  type="cylinder"
                  fromto="0 -0.25 0  0 0.25 0"
                  size="0.025"
                  mass="1.0"
                  rgba="0.20 0.35 0.80 1"/>

            <!-- LEFT STEERING ASSEMBLY -->
            <body name="steer_left_body"
                  pos="0 0.25 0">

                <joint name="steer_left_joint"
                       type="hinge"
                       pos="0 0 0"
                       axis="0 0 1"
                       range="-35 35"
                       limited="true"
                       damping="0.5"/>

                <geom name="steer_left_hub"
                      type="cylinder"
                      size="0.025 0.015"
                      mass="0.05"
                      contype="0"
                      conaffinity="0"
                      rgba="0 0 0 0"/>

                <body name="wheel_left_body"
                      pos="0 0 0">

                    <joint name="wheel_left_joint"
                           type="hinge"
                           pos="0 0 0"
                           axis="0 1 0"
                           damping="0.02"/>

                    <geom name="wheel_left_geom"
                          type="cylinder"
                          size="0.10 0.02"
                          euler="90 0 0"
                          mass="0.35"
                          friction="2.0 0.01 0.001"
                          condim="3"
                          rgba="0.15 0.15 0.15 1"/>

                </body>
            </body>

              <!-- RIGHT STEERING ASSEMBLY -->
                     <body name="steer_right_body"
                            pos="0 -0.25 0">

                            <joint name="steer_right_joint"
                                   type="hinge"
                                   pos="0 0 0"
                                   axis="0 0 1"
                                   range="-35 35"
                                   limited="true"
                                   damping="0.5"/>

                            <geom name="steer_right_hub"
                                   type="cylinder"
                                   size="0.025 0.015"
                                   mass="0.05"
                                   contype="0"
                                   conaffinity="0"
                                   rgba="0 0 0 0"/>

                            <body name="wheel_right_body"
                                   pos="0 0 0">

                            <joint name="wheel_right_joint"
                                   type="hinge"
                                   pos="0 0 0"
                                   axis="0 1 0"
                                   damping="0.02"/>

                            <geom name="wheel_right_geom"
                                   type="cylinder"
                                   size="0.10 0.02"
                                   euler="90 0 0"
                                   mass="0.35"
                                   friction="2.0 0.01 0.001"
                                   condim="3"
                                   rgba="0.15 0.15 0.15 1"/>

                            </body>
                     </body>

              </body>
       </body>
       
       <body name="target"
              mocap="true"
              pos="1.0 1.0 0.05">

              <geom name="target_geom"
                     type="sphere"
                     size="0.05"
                     density="0"
                     contype="0"
                     conaffinity="0"
                     rgba="0.1 0.8 0.2 0.8"/>

       </body>

    </worldbody>

    <actuator>

        <!-- Wheel drive -->
        <motor name="drive_left"
               joint="wheel_left_joint"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

        <motor name="drive_right"
               joint="wheel_right_joint"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

        <!-- Steering -->
        <position name="steer_left"
                  joint="steer_left_joint"
                  kp="50"
                  ctrllimited="true"
                  ctrlrange="-0.6109 0.6109"/>

        <position name="steer_right"
                  joint="steer_right_joint"
                  kp="50"
                  ctrllimited="true"
                  ctrlrange="-0.6109 0.6109"/>

    </actuator>

</mujoco>