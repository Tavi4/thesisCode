<mujoco model="joints_actuators">

    <compiler angle="degree"/>

    <worldbody>

        <light
            pos="0 0 2"
            dir="0 0 -1"
        />

        <geom
            name="floor"
            type="plane"
            size="2 2 0.1"
            rgba="0.85 0.85 0.85 1"
        />

        <body name="robot" pos="0 0 0.10">

            <!-- Chassis -->
            <geom
                type="cylinder"
                fromto="0 -0.25 0 0 0.25 0"
                size="0.025"
                rgba="0.20 0.35 0.80 1"
            />

            <!-- Left wheel -->
            <body name="left_wheel" pos="0 0.25 0">

                <geom
                    type="cylinder"
                    size="0.10 0.02"
                    euler="90 0 0"
                    rgba="0.15 0.15 0.15 1"
                />

                <!-- Joint - red -->
                <geom
                    type="sphere"
                    pos="0 0.03 0"
                    size="0.03"
                    rgba="1 0 0 1"
                    contype="0"
                    conaffinity="0"
                />

                <!-- Actuator - green -->
                <geom
                    type="sphere"
                    pos="0 0.07 0"
                    size="0.02"
                    rgba="0 1 0 1"
                    contype="0"
                    conaffinity="0"
                />

            </body>

            <!-- Right wheel -->
            <body name="right_wheel" pos="0 -0.25 0">

                <geom
                    type="cylinder"
                    size="0.10 0.02"
                    euler="90 0 0"
                    rgba="0.15 0.15 0.15 1"
                />

                <!-- Joint - red -->
                <geom
                    type="sphere"
                    pos="0 -0.03 0"
                    size="0.03"
                    rgba="1 0 0 1"
                    contype="0"
                    conaffinity="0"
                />

                <!-- Actuator - green -->
                <geom
                    type="sphere"
                    pos="0 -0.07 0"
                    size="0.02"
                    rgba="0 1 0 1"
                    contype="0"
                    conaffinity="0"
                />

            </body>

        </body>

    </worldbody>

</mujoco>