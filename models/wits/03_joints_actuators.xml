<mujoco model="joints_actuators">

    <compiler angle="degree"/>

    <worldbody>

        <light pos="0 0 2"
               dir="0 0 -1"/>

        <geom name="floor"
              type="plane"
              size="2 2 0.1"
              rgba="0.85 0.85 0.85 1"/>

        <body name="robot" pos="0 0 0.10">

            <geom
                type="cylinder"
                fromto="0 -0.25 0 0 0.25 0"
                size="0.025"
                rgba="0.20 0.35 0.80 1"
            />

            <body name="left_wheel" pos="0 0.25 0">

                <joint
                    name="left_wheel_joint"
                    type="hinge"
                    axis="0 1 0"
                />

                <geom
                    type="cylinder"
                    size="0.10 0.02"
                    euler="90 0 0"
                    rgba="0.15 0.15 0.15 1"
                />

            </body>

            <body name="right_wheel" pos="0 -0.25 0">

                <joint
                    name="right_wheel_joint"
                    type="hinge"
                    axis="0 1 0"
                />

                <geom
                    type="cylinder"
                    size="0.10 0.02"
                    euler="90 0 0"
                    rgba="0.15 0.15 0.15 1"
                />

            </body>

        </body>

    </worldbody>

    <actuator>

        <motor
            name="left_motor"
            joint="left_wheel_joint"
        />

        <motor
            name="right_motor"
            joint="right_wheel_joint"
        />

    </actuator>

</mujoco>